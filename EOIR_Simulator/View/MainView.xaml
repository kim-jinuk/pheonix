<Window x:Class="EOIR_Simulator.View.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:EOIR_Simulator.ViewModel"
        xmlns:model="clr-namespace:EOIR_Simulator.Model"
        xmlns:utils="clr-namespace:EOIR_Simulator.Utils"
        xmlns:h="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="EO/IR GUI" Height="720" Width="1050">

    <!-- MainViewModel 한-번만 생성 -->
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- ─ enum 리스트 (Manual / Scan 두 개) ─ -->
    <Window.Resources>
        <utils:StateToTextConverter x:Key="StateText"/>
        <x:Array x:Key="ModeItems" Type="{x:Type model:ModeNum}">
            <model:ModeNum>Manual</model:ModeNum>
            <model:ModeNum>Scan</model:ModeNum>
        </x:Array>
    </Window.Resources>

    <!-- ▒▒ 전체 레이아웃 ▒▒ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"  />
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- 운용 상태 텍스트 -->
        <TextBlock Text="{Binding State, Converter={StaticResource StateText}}"
           FontSize="14" FontWeight="Bold"
           Margin="8"
           HorizontalAlignment="Left"
           VerticalAlignment="Top"
           Panel.ZIndex="99"/>

        <!-- ▼ 좌측 : 영상 + 십자선 -->
        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1"
                Margin="8,68,8,68">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="1"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- 영상 -->
                <Image Source="{Binding Video.CurrentFrame}"
                       Stretch="Uniform"
                       Grid.RowSpan="3" Grid.ColumnSpan="3"/>

                <!-- 십자선 -->
                <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Fill="LawnGreen"/>
                <Rectangle Grid.Column="1" Grid.RowSpan="3" Fill="LawnGreen"/>
            </Grid>
        </Border>

        <!-- ▼ 우측 패널 : ScrollViewer -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- (0) 상태 -->
                    <RowDefinition Height="130"/>
                    <!-- (1) 객체표 -->
                    <RowDefinition Height="Auto"/>
                    <!-- (2) 모드선택 -->
                    <RowDefinition Height="80"/>
                    <!-- (3) 현재모드 -->
                    <RowDefinition Height="Auto"/>
                    <!-- (4) 방향키 -->
                </Grid.RowDefinitions>

                <!-- (0) 통신 상태 + Connect 버튼 -->
                <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" Margin="2,4,4,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="통신 상태"
                                           HorizontalAlignment="Center" Margin="0,4"/>

                        <Button Grid.Row="0" Grid.Column="1"
                                Content="{Binding Connection.ConnectButtonText,
                                                    FallbackValue=Connect}"
                                Command="{Binding Connection.ConnectCommand}"
                                Width="70" Margin="0,2,8,2"
                                ToolTip="EO/IR 연결 또는 해제"/>

                        <StackPanel Grid.Row="1" Margin="8,2" Grid.ColumnSpan="2">
                            <Border BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,4">
                                <TextBlock Text="{Binding Connection.TcpStatus}"
                                            FontWeight="Bold" Foreground="DodgerBlue"
                                            HorizontalAlignment="Center" Margin="4,2"/>
                            </Border>
                            <Border BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,4">
                                <TextBlock Text="{Binding Connection.UdpStatus}"
                                            FontWeight="Bold" Foreground="DarkOrange"
                                            HorizontalAlignment="Center" Margin="4,2"/>  
                            </Border>

                            <!-- 3-D 뷰와 각도 표시 -->
                            <Border Height="180" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,4">
                                <Grid>
                                    <h:HelixViewport3D ShowCoordinateSystem="False"
                                                        ZoomExtentsWhenLoaded="True"
                                                        Background="Black">
                                        <h:SunLight/>
                                        <h:LinesVisual3D Color="Red"  Thickness="0.6" Points="0 0 0 1 0 0"/>
                                        <h:LinesVisual3D Color="Lime" Thickness="0.6" Points="0 0 0 0 1 0"/>
                                        <h:LinesVisual3D Color="Blue" Thickness="0.6" Points="0 0 0 0 0 1"/>
                                        <h:ArrowVisual3D Point1="0 0 0"
                                                                 Point2="{Binding Angle.DirPoint}"
                                                                 Diameter="0.02" Fill="White"/>
                                        <h:BoxVisual3D Width="0.3" Height="0.1" Length="0.3"
                                                               Fill="#60AAFF00"
                                                               Transform="{Binding Angle.CubeTransform}"/>
                                    </h:HelixViewport3D>

                                    <!-- 각도 텍스트 -->
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                                        <TextBlock Text="{Binding Angle.AngleX, StringFormat='Yaw  {0}°'}"
                                                           FontSize="10" Foreground="White"/>
                                        <TextBlock Text="{Binding Angle.AngleY, StringFormat='Pitch {0}°'}"
                                                           FontSize="10" Foreground="White"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- (1) 메타데이터 -->
                <DataGrid Grid.Row="1" Margin="2,2,4,2"
                              ItemsSource="{Binding Video.Objects}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Cls"  Binding="{Binding Class}" Width="50"/>
                        <DataGridTextColumn Header="X"    Binding="{Binding X}"     Width="50"/>
                        <DataGridTextColumn Header="Y"    Binding="{Binding Y}"     Width="50"/>
                        <DataGridTextColumn Header="W"    Binding="{Binding W}"     Width="50"/>
                        <DataGridTextColumn Header="H"    Binding="{Binding H}"     Width="50"/>
                        <DataGridTextColumn Header="Conf" Binding="{Binding Confidence, StringFormat=F2}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- (2) 모드 선택 -->
                <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Margin="2,0,4,2">
                    <StackPanel Orientation="Horizontal" Margin="0,4"
                                HorizontalAlignment="Center">
                        <TextBlock Text="모드 선택 :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox SelectedValue="{Binding Mode, Mode=TwoWay}"
                                  SelectedValuePath="Tag"
                                  Width="120">  
                            <ComboBoxItem Content="수동 모드 (기본)" Tag="{x:Static model:ModeNum.Manual}" />
                            <ComboBoxItem Content="스캔 모드"   Tag="{x:Static model:ModeNum.Scan}"   />
                            <ComboBoxItem Content="추적 모드 (자동)" Tag="{x:Static model:ModeNum.Track}" 
                                          IsEnabled="False"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- (3) 현재 모드 표시 -->
                <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1" Margin="2,2,4,2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="현재 모드" HorizontalAlignment="Center" Margin="0,4"/>
                        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1"
                                    Margin="8,0,8,8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <TextBlock Text="{Binding Mode}" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- (4) 방향키 -->
                <Border Grid.Row="4" BorderBrush="Gray" BorderThickness="1" Margin="2,2,4,2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="서보 제어" HorizontalAlignment="Center" Margin="0,4"/>

                        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1"
                                    Margin="8,0,8,8" Padding="4">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <RepeatButton Content="↑" FontSize="18" 
                                              Command="{Binding MoveCommand}" CommandParameter="Up"
                                              IsEnabled="{Binding IsManualMode}"
                                              Delay="400" Interval="120"
                                              Grid.Row="0" Grid.Column="1" Width="60" Height="60" Margin="2"/>

                                <RepeatButton Content="←" FontSize="18" 
                                              Command="{Binding MoveCommand}" CommandParameter="Left"
                                              IsEnabled="{Binding IsManualMode}" 
                                              Delay="400" Interval="120"
                                              Grid.Row="1" Grid.Column="0" Width="60" Height="60" Margin="2"/>

                                <RepeatButton Content="↓" FontSize="18" 
                                              Command="{Binding MoveCommand}" CommandParameter="Down"
                                              IsEnabled="{Binding IsManualMode}" 
                                              Delay="400" Interval="120"
                                              Grid.Row="1" Grid.Column="1" Width="60" Height="60" Margin="2"/>

                                <RepeatButton Content="→" FontSize="18" 
                                              Command="{Binding MoveCommand}" CommandParameter="Right"
                                              IsEnabled="{Binding IsManualMode}"
                                              Delay="400" Interval="120"
                                              Grid.Row="1" Grid.Column="2" Width="60" Height="60" Margin="2"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
