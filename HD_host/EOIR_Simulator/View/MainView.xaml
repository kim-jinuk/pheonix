<Window x:Class="EOIR_Simulator.View.MainView"
        Loaded="Window_Loaded"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:EOIR_Simulator.ViewModel"
        xmlns:model="clr-namespace:EOIR_Simulator.Model"
        xmlns:utils="clr-namespace:EOIR_Simulator.Utils"
        xmlns:h="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="EO/IR GUI" Height="800" Width="1350" MinHeight="800" MinWidth="1050">

    <Window.Resources>
        <utils:BoolToBrushConverter x:Key="BoolToBrush"/>
        <x:Array x:Key="ModeItems" Type="{x:Type model:ModeNum}">
            <model:ModeNum>Manual</model:ModeNum>
            <model:ModeNum>Scan</model:ModeNum>
        </x:Array>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- 상태 표시 영역 -->
        <StackPanel Margin="16,16,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="99">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="EO/IR System State : " Foreground="Black" FontWeight="Bold" FontSize="16" Margin="0,0,6,0"/>
                <Ellipse Width="14" Height="14" Fill="{Binding Connection.StateColor}" Stroke="Black" StrokeThickness="1"/>
                <TextBlock Text="{Binding Connection.StateString}" FontSize="16" FontWeight="Bold" Foreground="Black" Margin="6,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Device State :" Foreground="Black" FontWeight="Bold" Margin="0,0,5,0"/>

                <Ellipse Width="14" Height="14" Fill="{Binding Connection.TpuStateColor}" Stroke="Black" StrokeThickness="1" Margin="0,0,4,0"/>
                <TextBlock Text="TPU" Foreground="Black" FontWeight="Bold" Margin="0,0,5,0"/>

                <Ellipse Width="14" Height="14" Fill="{Binding Connection.CamStateColor}" Stroke="Black" StrokeThickness="1" Margin="20,0,4,0"/>
                <TextBlock Text="CAM" Foreground="Black" FontWeight="Bold" Margin="0,0,5,0"/>
            </StackPanel>
        </StackPanel>


        <!-- 영상 표시 영역 -->
        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="8,68,8,68">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="1"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Video.CurrentFrame}" Stretch="Uniform" Grid.RowSpan="3" Grid.ColumnSpan="3"/>
                <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Fill="LawnGreen"/>
                <Rectangle Grid.Column="1" Grid.RowSpan="3" Fill="LawnGreen"/>
            </Grid>
        </Border>

        <!-- 오른쪽 제어 패널 -->
        <Grid Grid.Column="2" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,8" Padding="8">
                <StackPanel>

                    <!--/
                    <Button Content="{Binding ConnectionStateText}"
                            Command="{Binding ConnectionCommand}"
                            Width="150" Margin="0,0,0,5"
                            IsEnabled="{Binding IsOnlyConnectable}" />
                    <Button Content="{Binding Connection.RunButtonText}" Command="{Binding Connection.RunCommand}" Width="150" Margin="0,0,0,10"/>
-->

                    <Button Content="{Binding Connection.ConnectButtonText}"
                            Command="{Binding Connection.ConnectCommand}"
                            Width="150" Margin="0,0,0,5"
                            IsEnabled="{Binding Connection.IsConnectEnabled}" />

                    <Button Content="{Binding Connection.RunButtonText}"
                            Command="{Binding Connection.RunCommand}"
                            Width="150" Margin="0,0,0,5"
                            IsEnabled="{Binding Connection.IsRunEnabled}" />

                    <!--
                    <Button Content="{Binding ConnectButtonText}"
                            Command="{Binding ConnectCommand}"
                            Width="150" Margin="0,0,0,5"
                            IsEnabled="{Binding IsOnlyConnectable}"/>


                    <Button Content="{Binding RunButtonText}"
                        Command="{Binding RunCommand}"
                        Width="150" Margin="0,0,0,10"
                        IsEnabled="{Binding IsConnected}"/>
                    -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22.5">
                        <TextBlock Text="모드 선택 :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox SelectedValue="{Binding Mode, Mode=TwoWay}"
                                  SelectedValuePath="Tag"
                                  Width="120"
                                  Height="30"
                                  VerticalContentAlignment="Center"
          IsEnabled="{Binding Connection.AreOtherButtonsEnabled}">
                            <ComboBoxItem Content="수동 모드 (기본)" Tag="{x:Static model:ModeNum.Manual}" />
                            <ComboBoxItem Content="스캔 모드" Tag="{x:Static model:ModeNum.Scan}" />
                            <ComboBoxItem Content="추적 모드 (자동)" Tag="{x:Static model:ModeNum.Track}" IsEnabled="False" />
                        </ComboBox>

                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1">

                <StackPanel>

                    <!-- CAM 선택 영역 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8">
                        <TextBlock Text="카메라 선택" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="EO" Width="60" Margin="4,0"
                                Command="{Binding SetEOCamCommand}"
                                IsEnabled="{Binding Connection.AreOtherButtonsEnabled}"/>
                        <Button Content="IR" Width="60" Margin="4,0"
                                Command="{Binding SetIRCamCommand}"
                                IsEnabled="{Binding Connection.AreOtherButtonsEnabled}"/>
                    </StackPanel>


                    <!-- 전처리 옵션 영역 -->
                    <TextBlock Text="전처리 옵션 선택" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,12,0,4"/>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <CheckBox Content="Contrast" IsChecked="{Binding PrepContrast}"  Margin="2" IsEnabled="{Binding Connection.AreOtherButtonsEnabled}"/>
                        <CheckBox Content="Laplacian" IsChecked="{Binding PrepLaplacian}"  Margin="2" IsEnabled="{Binding Connection.AreOtherButtonsEnabled}"/>
                        <CheckBox Content="Denoise" IsChecked="{Binding PrepDenoise}"  Margin="2" IsEnabled="{Binding Connection.AreOtherButtonsEnabled}"/>
                        <CheckBox Content="Deblur" IsChecked="{Binding PrepDeblur}"  Margin="2" IsEnabled="{Binding Connection.AreOtherButtonsEnabled}"/>
                        <CheckBox Content="Clutter" IsChecked="{Binding PrepClutter}"  Margin="2" IsEnabled="{Binding Connection.AreOtherButtonsEnabled}"/>
                        <Button Content="전처리 적용" Command="{Binding SendPrepCommand}" Width="140" Margin="4,10" IsEnabled="{Binding Connection.AreOtherButtonsEnabled}"/>
                    </StackPanel>

                    <!-- 추적 명령 버튼 -->
                    <TextBlock Text="추적 명령" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,10,0,4"/>
                    <Button Content="Start Tracking" Command="{Binding SendTrackCommand}" Width="140" HorizontalAlignment="Center" IsEnabled="{Binding Connection.AreOtherButtonsEnabled}"/>
                    <StackPanel HorizontalAlignment="Center" Margin="0,20">
                        
                        <!-- 서보 제어 -->
                        <TextBlock Text="서보 제어" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,12,0,4"/>
                        <Grid HorizontalAlignment="Center" Margin="0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <RepeatButton Content="↑" Command="{Binding DirectionCommand}" CommandParameter="Up" Grid.Row="0" Grid.Column="1" Width="50" Height="50" Margin="4" IsEnabled="{Binding Connection.AreOtherButtonsEnabled}"/>
                            <RepeatButton Content="←" Command="{Binding DirectionCommand}" CommandParameter="Left" Grid.Row="1" Grid.Column="0" Width="50" Height="50" Margin="4" IsEnabled="{Binding Connection.AreOtherButtonsEnabled}"/>
                            <RepeatButton Content="↓" Command="{Binding DirectionCommand}" CommandParameter="Down" Grid.Row="1" Grid.Column="1" Width="50" Height="50" Margin="4" IsEnabled="{Binding Connection.AreOtherButtonsEnabled}"/>
                            <RepeatButton Content="→" Command="{Binding DirectionCommand}" CommandParameter="Right" Grid.Row="1" Grid.Column="2" Width="50" Height="50" Margin="4" IsEnabled="{Binding Connection.AreOtherButtonsEnabled}"/>

                        </Grid>
                    </StackPanel>
                </StackPanel>


            </StackPanel>
        </Grid>

        <!-- 중앙 오른쪽 상태 및 결과 -->
        <StackPanel Grid.Column="1" Margin="4">
            <Border BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" Margin="12,4">
                    <Ellipse Width="12" Height="12" Fill="{Binding Connection.TcpStateColor}" Stroke="Black" StrokeThickness="1" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Connection.TcpStatus}" FontSize="13" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" Margin="12,4">
                    <Ellipse Width="12" Height="12" Fill="{Binding Connection.CmdStateColor}" Stroke="Black" StrokeThickness="1" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Connection.CmdStatus}" FontSize="13" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            
            <Border BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" Margin="12,4">
                    <Ellipse Width="12" Height="12" Fill="{Binding Connection.UdpStateColor}" Stroke="Black" StrokeThickness="1" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Connection.UdpStatus}" FontSize="13" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" Margin="12,4" Height="25">
                    <TextBlock Text="mode : " FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Connection.ModeString}" FontSize="13" FontWeight="Bold"/>
                </StackPanel>
            </Border>


            <TextBlock Text="Detection Result:" FontWeight="Bold" Margin="8,8,8,4"/>
            <Border BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,4">
                <DataGrid Margin="4" Height="160" ItemsSource="{Binding Video.Objects}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Cls" Binding="{Binding Class}" Width="50"/>
                        <DataGridTextColumn Header="X" Binding="{Binding X}" Width="50"/>
                        <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="50"/>
                        <DataGridTextColumn Header="W" Binding="{Binding W}" Width="50"/>
                        <DataGridTextColumn Header="H" Binding="{Binding H}" Width="50"/>
                        <DataGridTextColumn Header="Conf" Binding="{Binding Confidence, StringFormat=F2}" Width="*"/>
                    </DataGrid.Columns>
                    

                </DataGrid>
                
 
            </Border>

            <Border Height="180" BorderBrush="Gray" BorderThickness="1" Margin="2,2,4,4">
                <Grid>
                    <h:HelixViewport3D ShowCoordinateSystem="False" ZoomExtentsWhenLoaded="True" Background="Black">
                        <h:SunLight/>
                        <h:LinesVisual3D Color="Red" Thickness="0.6" Points="0 0 0 1 0 0"/>
                        <h:LinesVisual3D Color="Lime" Thickness="0.6" Points="0 0 0 0 1 0"/>
                        <h:LinesVisual3D Color="Blue" Thickness="0.6" Points="0 0 0 0 0 1"/>
                        <h:ArrowVisual3D Point1="0 0 0" Point2="{Binding Angle.DirPoint}" Diameter="0.02" Fill="White"/>
                        <h:BoxVisual3D Width="0.3" Height="0.1" Length="0.3" Fill="#60AAFF00" Transform="{Binding Angle.CubeTransform}"/>
                    </h:HelixViewport3D>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                        <TextBlock Text="{Binding Angle.AngleX, StringFormat='Yaw  {0}°'}" FontSize="10" Foreground="White"/>
                        <TextBlock Text="{Binding Angle.AngleY, StringFormat='Pitch {0}°'}" FontSize="10" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>


            <TextBlock Text="Log:" FontWeight="Bold" Margin="8,8,8,4"/>
            <ListBox x:Name="LogListBox"
         ItemsSource="{Binding TcpLogs}"
         Height="400" Margin="8"
         FontFamily="Consolas" FontSize="12"
         BorderBrush="Gray" BorderThickness="1"
         VerticalContentAlignment="Top"
         Background="Black" Foreground="White"
         ScrollViewer.VerticalScrollBarVisibility="Auto"
         IsSynchronizedWithCurrentItem="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>


        </StackPanel>
    </Grid>
</Window>