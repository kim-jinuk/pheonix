<Window x:Class="EOIR_Simulator.View.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:EOIR_Simulator.ViewModel"
        xmlns:net="clr-namespace:EOIR_Simulator.Service" 
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:model="clr-namespace:EOIR_Simulator.Model"
        mc:Ignorable="d"
        Title="EO/IR GUI" Height="650" Width="1000">

    <!-- 디자인‑타임 VM -->
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- ModeNum 열거형 리스트 제공 -->
    <Window.Resources>
        <ObjectDataProvider x:Key="ModeValues"
                    MethodName="GetValues"
                    ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="model:ModeNum"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <!-- ▒▒ 레이아웃 ▒▒ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"   />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- 좌측: 영상 -->
        <Grid Grid.Column="0">
            <Image x:Name="VideoImage"
                   Source="{Binding CurrentFrame}"
                   Stretch="Uniform"/>
            <Canvas x:Name="Overlay"
                    IsHitTestVisible="False"/>
        </Grid>

        <!-- 우측 패널 -->
        <Grid Grid.Column="1" Margin="4,0,0,0">
            <Grid.RowDefinitions>
                <!-- (0) 상태 -->
                <RowDefinition Height="Auto"/>
                <!-- (1) DataGrid -->
                <RowDefinition Height="130"/>
                <!-- (2) 모드 -->
                <RowDefinition Height="Auto"/>
                <!-- (3) 현재 모드 표시 -->
                <RowDefinition Height="80"/>
                <!-- (4) 방향키 -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- (0) 상태 텍스트 -->
            <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" Margin="2,4,2,2">
                <Grid>
                    <!-- 버튼 칸 -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 타이틀 -->
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="통신 상태"
                   HorizontalAlignment="Center"
                   Margin="0,4"/>

                    <!-- ▣ Connect 버튼 (우측 상단) -->
                    <Button Grid.Row="0" Grid.Column="1"
                Content="{Binding ConnectButtonText}"
                Command="{Binding ConnectCommand}"
                Margin="0, 2, 8, 2"/>

                    <!-- 상태 텍스트들 (내부 Border로 감싸기) -->
                    <StackPanel Grid.Row="1" Margin="8,2" HorizontalAlignment="Stretch" Grid.ColumnSpan="2">
                        <Border BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,4">
                            <TextBlock Text="{Binding ConnectionStatus}"
                           FontWeight="Bold"
                           Foreground="DodgerBlue"
                           HorizontalAlignment="Center"
                           Margin="4,2"/>
                        </Border>

                        <Border BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,8">
                            <TextBlock Text="{Binding UdpStatus}"
                           FontWeight="Bold"
                           Foreground="DarkOrange"
                           HorizontalAlignment="Center"
                           Margin="4,2"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- (1) DataGrid -->
            <DataGrid x:Name="MetaGrid" Grid.Row="1"
                      ItemsSource="{Binding Objects}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      MaxHeight="120"
                      Margin="2,2,2,2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Cls"  Binding="{Binding Class}" Width="50"/>
                    <DataGridTextColumn Header="X"    Binding="{Binding X}"     Width="50"/>
                    <DataGridTextColumn Header="Y"    Binding="{Binding Y}"     Width="50"/>
                    <DataGridTextColumn Header="W"    Binding="{Binding W}"     Width="50"/>
                    <DataGridTextColumn Header="H"    Binding="{Binding H}"     Width="50"/>
                    <DataGridTextColumn Header="Conf" Binding="{Binding Confidence, StringFormat=F2}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- (2) 모드 선택 -->
            <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Margin="2,0,2,2">
                <StackPanel Orientation="Horizontal" Margin="0,4"
                HorizontalAlignment="Center">
                    <TextBlock Text="모드 선택 :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox SelectedValue="{Binding Mode, Mode=TwoWay}"
                              SelectedValuePath="Tag"
                              Width="120">  
                        <ComboBoxItem Content="수동 모드 (기본)" Tag="{x:Static model:ModeNum.Manual}" />
                        <ComboBoxItem Content="스캔 모드"   Tag="{x:Static model:ModeNum.Scan}"   />
                        <ComboBoxItem Content="추적 모드 (자동)" Tag="{x:Static model:ModeNum.Track}" IsEnabled="False"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- (3)  현재 모드 표시 -->
            <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1" Margin="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- 상단 텍스트 -->
                    <TextBlock Grid.Row="0"
                               Text="현재 모드"
                               HorizontalAlignment="Center"
                               Margin="0,4"/>
                    <!-- 내부 Border -->
                    <Border Grid.Row="1"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            Margin="8, 0, 8, 8"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <TextBlock Text="{Binding Mode}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- (4) 방향키 -->
            <Border Grid.Row="4" BorderBrush="Gray" BorderThickness="1" Margin="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- 타이틀 영역 -->
                        <RowDefinition Height="*"/>
                        <!-- 버튼 영역 -->
                    </Grid.RowDefinitions>

                    <!-- 타이틀 -->
                    <TextBlock Grid.Row="0" Text="서보 제어"
                   HorizontalAlignment="Center"
                   Margin="0,4"/>

                    <!-- 버튼 영역 Border -->
                    <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Margin="8, 0, 8, 8" Padding="4">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- ↑ -->
                            <Button Content="↑" FontSize="18"
                        Command="{Binding MoveCommand}" CommandParameter="Up"
                        IsEnabled="{Binding IsManualMode}"
                        Grid.Row="0" Grid.Column="1"
                        Width="60" Height="60" Margin="2"/>
                            <!-- ← -->
                            <Button Content="←" FontSize="18"
                        Command="{Binding MoveCommand}" CommandParameter="Left"
                        IsEnabled="{Binding IsManualMode}"
                        Grid.Row="1" Grid.Column="0"
                        Width="60" Height="60" Margin="2"/>
                            <!-- ↓ -->
                            <Button Content="↓" FontSize="18"
                        Command="{Binding MoveCommand}" CommandParameter="Down"
                        IsEnabled="{Binding IsManualMode}"
                        Grid.Row="1" Grid.Column="1"
                        Width="60" Height="60" Margin="2"/>
                            <!-- → -->
                            <Button Content="→" FontSize="18"
                        Command="{Binding MoveCommand}" CommandParameter="Right"
                        IsEnabled="{Binding IsManualMode}"
                        Grid.Row="1" Grid.Column="2"
                        Width="60" Height="60" Margin="2"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
